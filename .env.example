# Rota Fácil — copie para .env.local e preencha. Nunca coloque chaves secretas
# aqui: tudo que começa com VITE_ vai para o navegador.

# Etapa 3 — Supabase (Project Settings → API). Só a URL e a chave PÚBLICA (anon);
# a service_role nunca entra no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Geocodificação (endereço → coordenadas) pelo TomTom: grátis, sem cartão,
# 2.500 consultas por dia (developer.tomtom.com). Sem ela (e sem a do Google),
# o app usa o OpenStreetMap (Nominatim), gratuito, mas fraco em número de casa
# no Brasil. A chave fica visível no navegador.
VITE_TOMTOM_API_KEY=

# Geocodificação pelo Google (tem prioridade sobre o TomTom). Exige conta de
# faturamento no Google Cloud (no Brasil, o teste pede pré-pagamento).
# No Google Cloud Console: ative a "Maps JavaScript API" e a "Geocoding API" e
# restrinja a chave por "Sites" (HTTP referrer) ao domínio do app.
VITE_GOOGLE_MAPS_API_KEY=

# Tempos de viagem entre as paradas pelo OpenRouteService (cadastro grátis em
# openrouteservice.org). Sem ela, o app usa o servidor de demonstração do OSRM,
# que é só para teste. Esta chave fica visível no navegador; quando o Supabase
# entrar, a chamada passa para uma Edge Function.
VITE_ORS_API_KEY=

# Opcional: um OSRM próprio no lugar do servidor de demonstração.
VITE_OSRM_URL=

# Etapa 7 — o Google Cloud Vision NÃO usa variável aqui: a chave fica só no
# servidor, como secret da Supabase Edge Function.
